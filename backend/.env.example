# Copy to .env and fill in. Never commit .env.
# Free key: register at https://www.data.gov.in, then My Account -> API key
DATA_GOV_IN_API_KEY=

# Leave POSTGRES_DB empty to use SQLite
POSTGRES_DB=mandipulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
